# 复制成 deploy/.env；此文件不包含真实凭据。需要真实域名指向服务器并开放80/443。
APP_DOMAIN=chat.example.com
APP_ENV=production
AUTH_COOKIE_SECURE=true
REGISTRATION_ENABLED=false
# 首次创建管理员必须填写此口令。用密码管理器生成随机长口令，完成初始化后清空并重建容器。
BOOTSTRAP_TOKEN=
LLM_BASE_URL=
LLM_MODEL=
DEEPSEEK_API_KEY=
# 内网模型必须逐个授权完整API基础地址，JSON数组；容器中127.0.0.1指容器自身。
MODEL_INTERNAL_URLS=[]
MODEL_GLOBAL_CONCURRENCY=8
MODEL_USER_CONCURRENCY=3
MODEL_QUEUE_TIMEOUT=30
CHAT_GLOBAL_CONCURRENCY=32
CHAT_USER_CONCURRENCY=6
INDEX_CONCURRENCY=1
INDEX_QUEUE_LIMIT=100
USER_STORAGE_BYTES=104857600
TOTAL_STORAGE_BYTES=10737418240
USER_FILE_COUNT=200
# 默认使用卷内生成的加密主密钥，随全量数据备份。若改用环境变量，必须独立备份该值。
MODEL_CONFIG_ENCRYPTION_KEY=
