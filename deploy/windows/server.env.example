# 由Configure.ps1首次生成到独立运行目录；不提交实际server.env。
APP_ENV=production
AUTH_COOKIE_SECURE=true
REGISTRATION_ENABLED=false
BOOTSTRAP_TOKEN=
DATA_DIR=C:/ChatFoundryRuntime/data
HF_HOME=C:/ChatFoundryRuntime/cache/huggingface
XDG_DATA_HOME=C:/ChatFoundryRuntime/caddy/data
XDG_CONFIG_HOME=C:/ChatFoundryRuntime/caddy/config
LLM_BASE_URL=
LLM_MODEL=
DEEPSEEK_API_KEY=
MODEL_INTERNAL_URLS=[]
MODEL_GLOBAL_CONCURRENCY=2
MODEL_USER_CONCURRENCY=1
CHAT_GLOBAL_CONCURRENCY=4
CHAT_USER_CONCURRENCY=2
INDEX_CONCURRENCY=1
INDEX_QUEUE_LIMIT=20
EMBEDDING_DEVICE=cpu
EMBEDDING_PRELOAD=false
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false
WEB_BROWSER_ENABLED=false
WEB_LOADER_ENGINE=safe_web
USER_STORAGE_BYTES=52428800
TOTAL_STORAGE_BYTES=1073741824
USER_FILE_COUNT=100

# Optional history compaction; original history is retained.
# 默认不调用模型压缩历史；每次请求仍检查输入硬预算。
CONTEXT_COMPACTION_ENABLED=false
# 参考Open WebUI默认阈值；不代表模型支持80K，小窗口模型应调低。
CONTEXT_COMPACTION_TOKEN_THRESHOLD=80000
CONTEXT_COMPACTION_RETENTION_PERCENTAGE=40
CONTEXT_COMPACTION_RETRY_SECONDS=300

# 公开站点展示信息；备案号仅在实际部署配置填写，未填则不显示。
SITE_NAME=ChatFoundry
ICP_RECORD=
GONGAN_RECORD=
# 公安备案查询编号：取官方HTML链接中的code参数，支持14位或20位纯数字；留空链接到官方查询首页。
GONGAN_RECORD_CODE=
