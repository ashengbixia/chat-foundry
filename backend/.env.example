# 配置优先级：系统/进程环境变量 > backend/.env > 代码默认值。
# 本机开发可复制本文件为 .env，再填写真实配置；不要提交 .env。
# 也可以不创建 .env，直接在启动终端或 PyCharm 中设置以下环境变量。
LLM_BASE_URL=https://your-model-service.example/v1
DEEPSEEK_API_KEY=
LLM_MODEL=your-model-name
LLM_TIMEOUT=60
# 以下为应用预算默认值，不是对某个模型官方上下文上限的声明。
# 输入使用UTF-8字节数保守估算，不等同于精确Token计数；应按实际模型服务限制调整。
LLM_CONTEXT_WINDOW=32768
LLM_MAX_OUTPUT_TOKENS=4096
LLM_CONTEXT_MARGIN=1024
# 同Open WebUI默认：按工具调用批次计数，上限后另留一次最终回答。
# 0禁用模型工具迭代，-1不限制迭代；自动资料准备另计，输入预算仍有效。
CHAT_RESPONSE_MAX_TOOL_CALL_ITERATIONS=1024
# 启动后端时尝试准备本地向量模型：首次可能下载，后续使用磁盘缓存。
# 准备失败不阻止后端启动，索引或检索时可再次尝试。
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
# 登录有效期；本机HTTP开发为false，部署HTTPS后设为true。
AUTH_SESSION_DAYS=7
AUTH_COOKIE_SECURE=false
# 可选：用户个人模型Key的Fernet加密主密钥，必须固定保存且不提交Git。
# 留空时，首次保存个人Key会自动生成 backend/data/secrets/model-settings.key。
MODEL_CONFIG_ENCRYPTION_KEY=
# 联网搜索默认使用免Key的Bing RSS；可选duckduckgo、tavily或brave。
# 搜索服务Key独立配置，绝不复用DEEPSEEK_API_KEY或用户个人模型Key。
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=bing
WEB_SEARCH_API_KEY=
# 原生工具模式：默认3条候选，模型填写count也不能超过此上限；不改写搜索词。
WEB_SEARCH_RESULT_COUNT=3
# 可选的额外限额，默认不设置：
# WEB_SEARCH_MAX_ATTEMPTS=20
# 默认公开URL读取及静态加载；playwright使用浏览器，auto静态不足时回退浏览器。
WEB_URL_POLICY=public
WEB_LOADER_ENGINE=safe_web
# 以下默认不截短提取正文、不限制页面数；工具结果仍受传输和输入预算保护。
# WEB_FETCH_MAX_CONTENT_LENGTH=12000
# WEB_FETCH_MAX_PAGES=20
# 可选：WEB_URL_POLICY=sources启用严格来源范围。
# 旧配置WEB_BROWSER_ENABLED=true仍兼容；新配置优先使用WEB_LOADER_ENGINE。
# 使用浏览器前执行 python -m playwright install chromium。
# 子任务复用当前模型，独立保存历史；单任务总执行时间（秒）。
SUBAGENTS_ENABLED=true
SUBAGENT_TIMEOUT=300
## 开发方式保持不变：PyCharm uvicorn --reload，前端 npm run dev。
## 生产部署使用 deploy/.env.example 与 deploy/README.md。
APP_ENV=development
# 不填时固定保存到backend/data；如覆盖建议使用绝对路径。
# DATA_DIR=E:/chatfoundry-data
REGISTRATION_ENABLED=true
BOOTSTRAP_TOKEN=
MODEL_INTERNAL_URLS=[]
MODEL_GLOBAL_CONCURRENCY=8
MODEL_USER_CONCURRENCY=3
MODEL_QUEUE_TIMEOUT=30
CHAT_GLOBAL_CONCURRENCY=32
CHAT_USER_CONCURRENCY=6
INDEX_CONCURRENCY=1
INDEX_QUEUE_LIMIT=100
USER_STORAGE_BYTES=104857600
TOTAL_STORAGE_BYTES=10737418240
USER_FILE_COUNT=200
